# Leave unset locally to use Vite's same-origin R2 proxy. Override for a custom
# asset host only when its CORS policy permits the browser's origin.
# VITE_ASSET_URL=https://pub-c3aa1dfd53424ee9af1b87ad19954589.r2.dev
# Optional separate origin/prefix for lazy native dialogue voice clips:
# VITE_DIALOGUE_VOICE_URL=https://pub-c3aa1dfd53424ee9af1b87ad19954589.r2.dev/dialogue/voices/v1
# Set true only after extracting/restoring local runtime assets.
VITE_OFFLINE_ASSETS=false
# Optional when the multiplayer service is not behind the same origin:
# VITE_MULTIPLAYER_URL=wss://multiplayer.example.com/ws

# npm run dev:all finds a sibling ../new-yokosuka-server checkout by default.
# NEW_YOKOSUKA_SERVER_DIR=/path/to/new-yokosuka-server
# DEV_POSTGRES_DATABASE=new_yokosuka_server
