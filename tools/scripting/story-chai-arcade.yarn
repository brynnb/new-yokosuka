title: Fight
---
<<start_combat "s1.dgct.chai-arcade">>
<<if combat_result("s1.dgct.chai-arcade") == "success">>
<<start_activity "s1.dgct.chai-victory.scene">>
<<set_flag "story.s1.chai-arcade.won">>
{{effects}}
<<complete>>
<<elseif combat_result("s1.dgct.chai-arcade") == "defeated">>
