        "spoken": [
          {
            "id": "E1081B001",
            "text": "Hey Bro, What's up?",
            "speaker": "Goro Mihashi",
            "stage": "s1.mfsy.goro-guard-intro"
          },
          {
            "id": "E1081A001",
            "text": "Not much, Goro...not much.",
            "speaker": "Ryo Hazuki",
            "stage": "s1.mfsy.goro-guard-intro"
          },
          {
            "id": "E1081B002",
            "text": "If anything's bothering you, just tell your old pal Goro!",
            "speaker": "Goro Mihashi",
            "stage": "s1.mfsy.goro-guard-intro"
          },
          {
            "id": "E1081A002",
            "text": "Well, I got a question for you.",
            "speaker": "Ryo Hazuki",
            "stage": "s1.mfsy.goro-guard-intro"
          },
          {
            "id": "E1009BA013",
            "text": "I hear voices. Is someone there?",
            "speaker": "Ryo Hazuki",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BB001",
            "text": "Would ya' look at this invoice... The address is wrong.",
            "speaker": "Tomohito Niizato",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BC001",
            "text": "So it is.",
            "speaker": "Tsukasa Takagi",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BB002",
            "text": "I've asked them a million times to get it right.",
            "speaker": "Tomohito Niizato",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BC002",
            "text": "Yeah, it says right here... Old Warehouse District.",
            "speaker": "Tsukasa Takagi",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BC003",
            "text": "What are they thinking?",
            "speaker": "Tsukasa Takagi",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BB003",
            "text": "Can you call over to the Old Warehouse No. 8?",
            "speaker": "Tomohito Niizato",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BC004",
            "text": "OK, got it.",
            "speaker": "Tsukasa Takagi",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BA014",
            "text": "So there's another Warehouse No. 8?",
            "speaker": "Ryo Hazuki",
            "stage": "s1.ms8s.warehouse-eight-office"
          },
          {
            "id": "E1009BA017",
            "text": "I'll need to find the Old Warehouse District.",
            "speaker": "Ryo Hazuki",
            "stage": "s1.ms8s.warehouse-eight-office"
          }
        ]
      },
