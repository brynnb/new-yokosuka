+void captureNativeClothTrackBoundary()
+{
+	struct State
+	{
+		bool initialized = false;
+		bool finished = false;
+		bool headerWritten = false;
+		u32 targetModel = 0x2052474d;
+		u32 groupAddress = 0;
+		u32 sampleCount = 0;
+		u32 lastSlot = 0xffffffff;
+		u32 lastFrame = 0xffffffff;
+		u32 terminalSlot = 5;
+		u32 terminalFrame = 57;
+		u16 rowCount = 0;
+		u16 columnCount = 0;
+		std::string path;
+		std::ofstream output;
+	};
+	static State state;
+	if (!state.initialized)
+	{
+		state.initialized = true;
+		const char *path = std::getenv("FLYCAST_CLOTH_TRACK_OUTPUT");
+		if (path == nullptr || path[0] == '\0')
+		{
+			state.finished = true;
+			return;
+		}
+		state.path = path;
+		if (const char *value = std::getenv("FLYCAST_CLOTH_TRACK_MODEL"))
+			state.targetModel = std::strtoul(value, nullptr, 0);
+		if (const char *value = std::getenv("FLYCAST_CLOTH_TRACK_TERMINAL_SLOT"))
+			state.terminalSlot = std::strtoul(value, nullptr, 0);
+		if (const char *value = std::getenv("FLYCAST_CLOTH_TRACK_TERMINAL_FRAME"))
+			state.terminalFrame = std::strtoul(value, nullptr, 0);
+		if (const char *value = std::getenv("FLYCAST_CLOTH_TRACK_ROWS"))
+			state.rowCount = std::strtoul(value, nullptr, 0);
+		if (const char *value = std::getenv("FLYCAST_CLOTH_TRACK_COLUMNS"))
+			state.columnCount = std::strtoul(value, nullptr, 0);
+		state.output.open(state.path, std::ios::binary | std::ios::trunc);
+		if (!state.output)
+		{
+			ERROR_LOG(PVR, "Cannot create native cloth track %s", state.path.c_str());
+			state.finished = true;
+		}
+	}
+	if (state.finished)
+		return;
+
+	const u32 active = ReadMem32(0x0c222b00);
+	if (active == 0)
+		return;
+	const u32 resource = ReadMem32(active + 0x0c);
+	u32 slot = 0xffffffff;
+	u32 matches = 0;
+	for (u32 candidate = 0; candidate < 70; candidate++)
+	{
+		if (ReadMem32(0x0c222588 + candidate * 0x14 + 4) == resource)
+		{
+			slot = candidate;
+			matches++;
+		}
+	}
+	if (matches != 1)
+		return;
+	const u32 frame = ReadMem32(active + 0x2c);
+	if (state.sampleCount != 0 && slot == state.lastSlot && frame <= state.lastFrame)
+		return;
+
+	if (state.groupAddress == 0)
+	{
+		const u32 candidate = Sh4cntx.r[14];
+		const u32 owner = ReadMem32(candidate + 0x80);
+		const u32 vertexCount = ReadMem32(candidate + 0x08);
+		const u32 vertexState = ReadMem32(candidate + 0x0c);
+		if (owner == 0 || ReadMem32(owner + 0x2c) != state.targetModel
+				|| vertexCount == 0 || vertexCount >= 10000
+				|| vertexState < 0x0c000000 || vertexState >= 0x0d000000)
+			return;
+		state.groupAddress = candidate;
+	}
+
+	if (!state.headerWritten)
+	{
+		unsigned char header[40] = {};
+		std::memcpy(header, "NYCLTH01", 8);
+		header[8] = 2;
+		header[10] = 40;
+		const u32 vertexCount = ReadMem32(state.groupAddress + 0x08);
+		if (state.rowCount == 0 || state.columnCount == 0
+				|| state.rowCount * state.columnCount != vertexCount)
+		{
+			ERROR_LOG(PVR, "Native cloth track topology does not match %u vertices", vertexCount);
+			state.finished = true;
+			state.output.close();
+			return;
+		}
+		const u32 vertexState = ReadMem32(state.groupAddress + 0x0c);
+		for (u32 vertex = 0; vertex < vertexCount; vertex++)
+		{
+			float values[6];
+			for (u32 component = 0; component < 6; component++)
+			{
+				const u32 word = ReadMem32(vertexState + (vertex * 6 + component) * 4);
+				std::memcpy(&values[component], &word, 4);
+			}
+			const float dx = values[3] - values[0];
+			const float dy = values[4] - values[1];
+			const float dz = values[5] - values[2];
+			if (!std::isfinite(dx) || !std::isfinite(dy) || !std::isfinite(dz)
+					|| dx * dx + dy * dy + dz * dz <= 1.0e-6f)
+				return;
+		}
+		std::memcpy(header + 16, &vertexCount, 4);
+		const u16 controlType = ReadMem16(state.groupAddress + 0x04);
+		std::memcpy(header + 20, &controlType, 2);
+		std::memcpy(header + 22, &state.rowCount, 2);
+		std::memcpy(header + 24, &state.columnCount, 2);
+		header[26] = 6;
+		std::memcpy(header + 28, &state.targetModel, 4);
+		const float scale = 1.0f / 8192.0f;
+		std::memcpy(header + 32, &scale, 4);
+		state.output.write(reinterpret_cast<const char *>(header), sizeof(header));
+		state.headerWritten = true;
+		NOTICE_LOG(PVR, "Native cloth track started at AUTH slot %u frame %u", slot, frame);
+	}
+
+	const u32 owner = ReadMem32(state.groupAddress + 0x80);
+	if (owner == 0 || ReadMem32(owner + 0x2c) != state.targetModel)
+		return;
+	state.lastSlot = slot;
+	state.lastFrame = frame;
+	const u16 slot16 = slot;
+	const u16 reserved = 0;
+	state.output.write(reinterpret_cast<const char *>(&slot16), 2);
+	state.output.write(reinterpret_cast<const char *>(&reserved), 2);
+	state.output.write(reinterpret_cast<const char *>(&frame), 4);
+	const u32 vertexCount = ReadMem32(state.groupAddress + 0x08);
+	const u32 vertexState = ReadMem32(state.groupAddress + 0x0c);
+	for (u32 component = 0; component < vertexCount * 6; component++)
+	{
+		const u32 word = ReadMem32(vertexState + component * 4);
+		float value;
+		std::memcpy(&value, &word, 4);
+		const long quantized = std::lround(value * 8192.0f);
+		const s16 sample = static_cast<s16>(std::max(-32768L, std::min(32767L, quantized)));
+		state.output.write(reinterpret_cast<const char *>(&sample), 2);
+	}
+	state.sampleCount++;
+	state.output.flush();
+
+	if (slot == state.terminalSlot && frame >= state.terminalFrame)
+	{
+		state.output.seekp(12);
+		state.output.write(reinterpret_cast<const char *>(&state.sampleCount), 4);
+		state.output.close();
+		std::ofstream done(state.path + ".done");
+		done << state.sampleCount << '\n';
+		state.finished = true;
+		NOTICE_LOG(PVR, "Native cloth track completed with %u samples", state.sampleCount);
+	}
+}
