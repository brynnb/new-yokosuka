  "entries": [
    {"name":"flag_set","kind":"function","description":"Returns whether a named story flag is set.","parameters":[{"name":"flag","type":"string","identifierKind":"flag"}],"returnType":"bool","authority":"server","wait":"none","cleanup":"none","dependencies":[{"access":"read","kind":"flag","parameter":"flag"}]},
    {"name":"progress_value","kind":"function","description":"Returns a named conversation or story progress value.","parameters":[{"name":"progress","type":"string","identifierKind":"progress"}],"returnType":"number","authority":"server","wait":"none","cleanup":"none","dependencies":[{"access":"read","kind":"progress","parameter":"progress"}]},
    {"name":"has_item","kind":"function","description":"Returns whether the character owns at least the requested item quantity.","parameters":[{"name":"item","type":"string","identifierKind":"item"},{"name":"quantity","type":"number"}],"returnType":"bool","authority":"server","wait":"none","cleanup":"none","dependencies":[{"access":"read","kind":"item","parameter":"item"}]},
    {"name":"yen","kind":"function","description":"Returns the authoritative character yen balance.","parameters":[],"returnType":"number","authority":"server","wait":"none","cleanup":"none","dependencies":[]},
    {"name":"actor_present","kind":"function","description":"Returns whether an actor is currently resident in the room.","parameters":[{"name":"actor","type":"string","identifierKind":"actor"}],"returnType":"bool","authority":"server","wait":"none","cleanup":"none","dependencies":[{"access":"read","kind":"actor","parameter":"actor"}]},
    {"name":"in_scene","kind":"function","description":"Returns whether the player is in the named scene.","parameters":[{"name":"scene","type":"string","identifierKind":"scene"}],"returnType":"bool","authority":"server","wait":"none","cleanup":"none","dependencies":[{"access":"read","kind":"scene","parameter":"scene"}]},
    {"name":"game_hour","kind":"function","description":"Returns the authoritative in-game hour.","parameters":[],"returnType":"number","authority":"server","wait":"none","cleanup":"none","dependencies":[]},
    {"name":"game_date_on_or_after","kind":"function","description":"Returns whether the authoritative in-game month and day are on or after the supplied calendar date.","parameters":[{"name":"month","type":"number"},{"name":"day","type":"number"}],"returnType":"bool","authority":"server","wait":"none","cleanup":"none","dependencies":[]},
    {"name":"random_integer","kind":"function","description":"Returns a uniformly selected authoritative integer in the inclusive range.","parameters":[{"name":"minimum","type":"number"},{"name":"maximum","type":"number"}],"returnType":"number","authority":"server","wait":"none","cleanup":"none","dependencies":[]},
    {"name":"actor_in_bounds","kind":"function","description":"Tests an actor against a catalogued authored spatial region.","parameters":[{"name":"actor","type":"string","identifierKind":"actor"},{"name":"bounds","type":"string","identifierKind":"bounds"}],"returnType":"bool","authority":"server","wait":"none","cleanup":"none","dependencies":[{"access":"read","kind":"actor","parameter":"actor"}]},

    {"name":"set_flag","kind":"command","description":"Sets a named story flag in the event transaction.","parameters":[{"name":"flag","type":"string","identifierKind":"flag"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["story-state"],"dependencies":[{"access":"write","kind":"flag","parameter":"flag"}]},
    {"name":"clear_flag","kind":"command","description":"Clears a named story flag in the event transaction.","parameters":[{"name":"flag","type":"string","identifierKind":"flag"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["story-state"],"dependencies":[{"access":"write","kind":"flag","parameter":"flag"}]},
    {"name":"set_progress","kind":"command","description":"Writes a named conversation or story progress value in the event transaction.","parameters":[{"name":"progress","type":"string","identifierKind":"progress"},{"name":"value","type":"number"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["story-state"],"dependencies":[{"access":"write","kind":"progress","parameter":"progress"}]},
    {"name":"increment_progress","kind":"command","description":"Adds a positive finite amount to a named conversation or story progress value in the event transaction.","parameters":[{"name":"progress","type":"string","identifierKind":"progress"},{"name":"amount","type":"number"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["story-state"],"dependencies":[{"access":"write","kind":"progress","parameter":"progress"}]},
    {"name":"give_item","kind":"command","description":"Adds an item to the authoritative character inventory on commit.","parameters":[{"name":"item","type":"string","identifierKind":"item"},{"name":"quantity","type":"number"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["inventory"],"dependencies":[{"access":"write","kind":"item","parameter":"item"}]},
    {"name":"remove_item","kind":"command","description":"Removes an item from the authoritative character inventory on commit.","parameters":[{"name":"item","type":"string","identifierKind":"item"},{"name":"quantity","type":"number"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["inventory"],"dependencies":[{"access":"write","kind":"item","parameter":"item"}]},
    {"name":"grant_yen","kind":"command","description":"Adds yen to the authoritative character balance on commit.","parameters":[{"name":"amount","type":"number"},{"name":"reason","type":"string"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["economy"],"dependencies":[]},
    {"name":"spend_yen","kind":"command","description":"Atomically spends yen or fails the event branch.","parameters":[{"name":"amount","type":"number"},{"name":"reason","type":"string"}],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["economy"],"dependencies":[]},

    {"name":"play_player_motion","kind":"command","description":"Plays a catalogued player motion under event ownership.","parameters":[{"name":"motion","type":"string","identifierKind":"motion"}],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"event-owned","sideEffects":["player-control"],"dependencies":[]},
    {"name":"look_at_actor","kind":"command","description":"Gives an actor an event-owned look target and waits for client to apply it.","parameters":[{"name":"actor","type":"string","identifierKind":"actor"},{"name":"target","type":"string","identifierKind":"actor"}],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"restore-previous","sideEffects":["actor-control"],"dependencies":[{"access":"write","kind":"actor","parameter":"actor"},{"access":"read","kind":"actor","parameter":"target"}]},
    {"name":"clear_actor_look","kind":"command","description":"Releases the event-owned look target and waits for client to apply the release.","parameters":[{"name":"actor","type":"string","identifierKind":"actor"}],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"event-owned","sideEffects":["actor-control"],"dependencies":[{"access":"write","kind":"actor","parameter":"actor"}]},
    {"name":"start_camera","kind":"command","description":"Starts a catalogued authored camera preset.","parameters":[{"name":"camera","type":"string","identifierKind":"camera"}],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"restore-previous","sideEffects":["camera"],"dependencies":[]},
    {"name":"stop_camera","kind":"command","description":"Stops the event camera and restores the previous camera owner.","parameters":[],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"event-owned","sideEffects":["camera"],"dependencies":[]},
    {"name":"play_sequence","kind":"command","description":"Runs a catalogued authored presentation sequence whose internal timing or overlap cannot be represented as ordered dialogue commands.","parameters":[{"name":"sequence","type":"string","identifierKind":"sequence"}],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"event-owned","sideEffects":["actor-control","object-state","audio"],"dependencies":[]},
    {"name":"start_activity","kind":"command","description":"Runs a registered presentation-only specialized activity and waits for its client cleanup acknowledgment. It cannot authorize a gameplay result or durable state.","parameters":[{"name":"activity","type":"string","identifierKind":"activity"}],"authority":"server-orchestrated-presentation","wait":"client-ack","cleanup":"event-owned","sideEffects":["activity-presentation"],"dependencies":[{"access":"write","kind":"activity","parameter":"activity"}]},
    {"name":"pass_trigger","kind":"command","description":"Before any player-visible yield, commits explicitly staged gate state and continues trigger dispatch with the next lower-priority candidate.","parameters":[],"authority":"server","wait":"none","cleanup":"transactional","sideEffects":["event-lifecycle"],"dependencies":[]},
    {"name":"complete","kind":"command","description":"Completes the event and commits its staged durable state.","parameters":[],"authority":"server","wait":"none","cleanup":"event-owned","sideEffects":["event-lifecycle"],"dependencies":[]}
